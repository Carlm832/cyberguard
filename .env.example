# Gemini API Key (Required)
# Get one at https://aistudio.google.com/
GEMINI_API_KEY=your_key_here

#Open Router API Key for Live Threat
OPEN_ROUTER_API_KEY = 

# Have I Been Pwned API Key (Optional)
HIBP_API_KEY=your_key_here

# ARIA Cloud Usage Controls
# Use local to avoid Gemini calls, or auto to use Gemini with local fallback.
ARIA_MODE=auto
ARIA_MAX_CLOUD_MESSAGES=8
ARIA_MAX_OUTPUT_TOKENS=420

# Threat Intel Feed Controls
# Remote feed is disabled by default to preserve API/network budget.
THREAT_FEED_ENABLED=false
THREAT_FEED_CACHE_SECONDS=3600
# THREAT_FEED_URL=https://example.com/feed.json
# THREAT_FEED_API_KEY=your_optional_feed_key

# Mailjet SMTP Settings (Required for Share to Email)
SMTP_HOST=in-v3.mailjet.com
SMTP_PORT=587
SMTP_USER=your_mailjet_api_key
SMTP_PASSWORD=your_mailjet_secret_key
SMTP_FROM=your_verified_sender_email@gmail.com
